<?php
/**
 * The Downloads block.
 *
 * DOM and class names deliberately mirror the theme's own
 * `agile-item/download-item-block.phtml` (.download / .download--item /
 * .download--metadata / .icon-left-download / .icon-left-metadata), so pitts3's
 * existing styling and icon SVGs apply with no new CSS. The theme lays .download
 * out as a flex row; with the per-type opt-in and the threshold keeping counts
 * small, several buttons sit on one line as the single button does today.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $item
 * @var \Omeka\Api\Representation\MediaRepresentation[] $media Already filtered by
 *      DownloadResolver: opted-in types only, non-empty files, threshold applied,
 *      in attachment order. May be empty.
 * @var string[] $labelPatterns Custom link text keyed by media id, for the media
 *      an admin has labelled; absent means the built-in label. May carry {size}.
 * @var bool $includeMetadata Whether to offer the item's metadata (global/site
 *      setting, resolved by the block). Independent of $media: an item with no
 *      downloadable files still offers its metadata when this is on.
 */

use AdvancedMedia\Media\MediaTypeLabel;

$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

$includeMetadata = !empty($includeMetadata);

$metadataFilename = 'metadata-' . urlencode(strtolower(str_replace(' ', '_', (string) $item->title()))) . '.json';

$labelPatterns = isset($labelPatterns) && is_array($labelPatterns) ? $labelPatterns : [];

// Resolve URLs and label patterns once, up front, so the counts below reflect
// only the buttons that will actually render — not media the resolver passed but
// which yield no download URL (there should be none, but the count must be honest).
//
// Every label is a PATTERN, built-in or custom: "Download PDF ({size})" is simply
// what an unlabelled PDF gets. Files are then counted per pattern, not per media
// type, because the pattern is what the visitor reads. Two files that read the
// same need numbering; a .vtt and a .txt that are both text/plain but labelled
// differently do not.
$rows = [];
$patternTotals = [];
foreach ($media as $m) {
    $url = $this->advancedMediaDownloadUrl($m);
    if (!$url) {
        continue;
    }
    $name = $translate(MediaTypeLabel::name($m));
    $pattern = $labelPatterns[$m->id()]
        ?? sprintf($translate('Download %s (%s)'), $name, MediaTypeLabel::SIZE_TOKEN);
    $patternTotals[$pattern] = ($patternTotals[$pattern] ?? 0) + 1;
    $rows[] = ['media' => $m, 'url' => $url, 'name' => $name, 'pattern' => $pattern];
}

// Running per-pattern counter, consumed only when a pattern has more than one file.
$patternSeen = [];
?>
<?php // The block renders when it has ANYTHING to offer. Gating it on $rows alone
      // is the bug this replaces: the metadata link vanished from every item that
      // had no downloadable file. ?>
<?php if ($rows || $includeMetadata): ?>
<div class="download advancedmedia-downloads">

  <?php foreach ($rows as $row): ?>
    <?php
    $m = $row['media'];
    $url = $row['url'];

    $name = $row['name'];
    $pattern = $row['pattern'];

    // "Download PDF (1.2 MB)". The size is omitted rather than shown as 0 when
    // it is unknown — every record in this install has one, but a fresh ingest
    // or a hand-edited row may not.
    //
    // Numbered only when the item has MORE THAN ONE file reading the same —
    // "Download TIFF image 1", "…2" — so a lone PDF stays "Download PDF" rather
    // than the noisy "Download PDF 1". The counter runs in attachment order,
    // matching the order the buttons appear.
    $patternSeen[$pattern] = ($patternSeen[$pattern] ?? 0) + 1;
    $label = MediaTypeLabel::compose(
        $pattern,
        MediaTypeLabel::size($m),
        $patternTotals[$pattern] > 1 ? $patternSeen[$pattern] : null
    );

    // Belt and braces. With proxying on, the attachment disposition comes from
    // the presigned S3 response and this attribute is redundant; on a local
    // install it is what does the work. It is inert cross-origin.
    $filename = basename((string) $m->filename());

    // The filename, NOT displayTitle(): media here are commonly sideloaded, so
    // displayTitle() falls back to `source`, which is a full S3 URL. A tooltip
    // reading "Download https://pittspublic.s3-us-west-2.amazonaws.com/..." is
    // worse than no tooltip. The filename is the one thing the label omits.
    $title = $filename !== '' ? $filename : $name;
    ?>
    <div class="download--item">
      <?php // escapeHtml, not escapeHtmlAttr, for the same reason the config
            // template gives: escapeHtmlAttr hex-encodes every non-alphanumeric
            // character, so a URL becomes http&#x3A;&#x2F;&#x2F;… — valid, and
            // browsers decode it, but unreadable in view-source and undebuggable.
            // These attributes are double-quoted and escapeHtml escapes quotes. ?>
      <a class="icon-left-download"
         href="<?= $escape($url) ?>"
         title="<?= $escape($title) ?>"
         <?= $filename !== '' ? 'download="' . $escape($filename) . '"' : '' ?>>
        <?= $escape($label) ?>
      </a>
    </div>
  <?php endforeach; ?>

  <?php if ($includeMetadata): ?>
  <?php // Same-origin, so this one has always worked — unlike the media links. ?>
  <div class="download--metadata">
    <a class="icon-left-metadata"
       title="<?= $escape($translate('Download metadata')) ?>"
       target="_blank"
       type="application/json"
       href="<?= $escape($item->apiUrl()) ?>"
       download="<?= $escape($metadataFilename) ?>">
      <?= $escape($translate('Download Metadata')) ?>
    </a>
  </div>
  <?php endif; ?>

</div>
<?php endif; ?>
