<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string $audioSrc
 * @var string|null $transcriptSrc
 * @var string|null $transcriptId
 *
 * The <video> carries native `controls` and is visible by default; the JS adds
 * `.ca-enhanced` to the container, which hides it and reveals the SVG player.
 * So if JS/jQuery is unavailable, audio still works natively.
 *
 * Note the <track> deliberately has NO `src` and the <video> NO `crossorigin`.
 * A cross-origin text track requires `crossorigin`, but that attribute also puts
 * the MEDIA into CORS mode — so on a host without CORS headers it kills audio
 * playback outright, not just captions. Instead the JS probes the media host and
 * only then switches into anonymous CORS mode and attaches the track.
 */
?>
<div class="media-container audio advancedmedia-circular" data-type="audio">
  <div class="ca-player-container" style="opacity: 0.5">
    <svg class="not-started" viewBox="0 0 100 100" version="1.1" xmlns="http://www.w3.org/2000/svg" width="50%" height="50%">
      <g class="shape">
        <circle class="progress-track" cx="50" cy="50" r="47.45" stroke="#3499CC" stroke-opacity="0.25" stroke-linecap="square" fill="none" stroke-width="5" />
        <circle class="precache-bar" cx="50" cy="50" r="47.45" stroke="#3499CC" stroke-opacity="0.25" stroke-linecap="square" fill="none" stroke-width="5" transform="rotate(-90 50 50)" />
        <circle class="progress-bar" cx="50" cy="50" r="47.45" stroke="#3499CC" stroke-opacity="1" stroke-linecap="square" fill="none" stroke-width="5" transform="rotate(-90 50 50)" />
      </g>
      <circle class="controls" cx="50" cy="50" r="25" stroke="none" fill="#000000" opacity="0.0" pointer-events="all" />
      <g class="control pause">
        <line x1="45" y1="35" x2="45" y2="65" stroke="#3499CC" fill="#3499CC" stroke-width="3" stroke-linecap="square" />
        <line x1="55" y1="35" x2="55" y2="65" stroke="#3499CC" fill="#3499CC" stroke-width="3" stroke-linecap="square" />
      </g>
      <g class="control play">
        <path transform="translate(40, 32) scale(0.5)" d="M60.5513 35.47L0.0905762 0.575974V70.364L60.5513 35.47Z" fill="#3499CC" />
      </g>
      <g class="control stop">
        <rect x="35" y="35" width="30" height="30" stroke="#000000" fill="none" stroke-width="1" />
      </g>
    </svg>
    <div class="ca-timer"><span class="current-time">00:00</span> / <span class="duration">(loading audio)</span></div>
    <div class="ca-caption"></div>
    <video src="<?= $this->escapeHtmlAttr($audioSrc) ?>" class="ca-player" controls preload="metadata" width="650" height="60">
      <?php if (!empty($transcriptSrc)): ?>
        <track default kind="captions" srclang="en" data-src="<?= $this->escapeHtmlAttr($transcriptSrc) ?>"<?php if ($transcriptId): ?> data-transcript-id="<?= $this->escapeHtmlAttr($transcriptId) ?>"<?php endif; ?> />
      <?php endif; ?>
    </video>
  </div>
</div>
