<?php
/**
 * The shared configuration component. Mounted at BOTH scopes (config-ui-spec §2.3):
 * global (module config, where we own the page) and site (inside core's settings
 * form, which has no tabs). Only the surrounding chrome differs.
 *
 * Section order (top to bottom): status/anomaly alerts, summary, per-site overview,
 * then the four editable sets — General settings, Media players and downloads,
 * Resource template overrides, Media structures.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $options From AdvancedMedia\Config\ConfigOptions::build()
 */
$escape = $this->plugin('escapeHtml');
$escapeAttr = $this->plugin('escapeHtmlAttr');
$translate = $this->plugin('translate');

$scope = $options['scope'];
$context = $options['context'];
$keys = $options['keys'];
$stored = $options['stored'];
$inherited = $options['inherited'];
$inheritLabel = $translate($options['inheritLabel']);

/**
 * One row: a select whose EMPTY option means "inherit".
 *
 * The inherit option is labelled with what the row would actually resolve to, so an
 * inherited row and a row explicitly set to the same value are visibly different.
 * Losing that distinction is what silently breaks propagation of later global
 * changes (architecture §5.2) — it is the whole reason the null state exists.
 */
$row = function (string $settingKey, string $rowKey, array $choices, ?string $storedValue, ?string $inheritedValue, ?string $emptyLabel = null)
    use ($escape, $escapeAttr, $translate, $context, $inheritLabel, $scope) {
    $name = sprintf('%s[%s][%s]', $settingKey, $context, $rowKey);
    $isInheriting = ($storedValue === null || $storedValue === '');
    $effective = $isInheriting ? $inheritedValue : $storedValue;

    // A template row that is unset is not "using a default" — there IS no default
    // template mapping. It simply is not overriding anything, and the structure rows
    // decide. Say that, rather than inventing a default that does not exist.
    $inheritText = $emptyLabel !== null ? $translate($emptyLabel) : $inheritLabel;
    if ($emptyLabel === null && $inheritedValue !== null) {
        $inheritText .= sprintf(' (%s: %s)', $translate('currently'),
            $choices[$inheritedValue] ?? $inheritedValue);
    }

    // escapeHtml, not escapeHtmlAttr: these attributes are double-quoted and the
    // values are internal keys (setting names, media types, compound names).
    // escapeHtmlAttr hex-encodes every non-alphanumeric character, which turns
    // name="advancedmedia_players[page][image/jpeg]" into unreadable soup. It still
    // POSTs correctly — browsers decode entities — but nobody can debug it.
    $html = sprintf(
        '<select name="%s" class="advmedia-select%s">',
        $escape($name),
        $isInheriting ? ' is-inherited' : ''
    );
    $html .= sprintf('<option value=""%s>%s</option>',
        $isInheriting ? ' selected' : '', $escape($inheritText));
    foreach ($choices as $value => $label) {
        $html .= sprintf('<option value="%s"%s>%s</option>',
            $escape((string) $value),
            (!$isInheriting && $storedValue === (string) $value) ? ' selected' : '',
            $escape($translate($label))
        );
    }
    $html .= '</select>';

    // At GLOBAL scope an explicit value is self-evident from the select itself
    // ("Yes" is plainly not "Use default"), and there is nothing above global to
    // override — so no badge. At SITE scope the badge names what the row actually
    // does: it overrides the global value, and saying so is the useful part.
    if (!$isInheriting && $scope === 'site') {
        $html .= sprintf(' <span class="advmedia-overridden">%s</span>', $escape($translate('overrides global')));
    }
    // A stored value we can no longer offer (its module was uninstalled). Never
    // rewritten — the module may come back (config-ui-spec §8).
    if (!$isInheriting && !isset($choices[$storedValue])) {
        $html .= sprintf(
            '<p class="advmedia-warn">%s <code>%s</code> %s <strong>%s</strong>.</p>',
            $escape($translate('Warning:')),
            $escape($storedValue),
            $escape($translate('is not available in this install, so this row is being ignored. Effective:')),
            $escape($effective !== null && isset($choices[$effective]) ? $choices[$effective] : $translate('individual media'))
        );
    }
    return $html;
};
?>

